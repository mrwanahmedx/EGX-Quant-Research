{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen Pre-Holdout Source Snapshot Manifest",
  "type": "object",
  "required": [
    "kind",
    "created_at",
    "development_cutoff",
    "sources",
    "composite_fingerprint",
    "authorized_for_development"
  ],
  "properties": {
    "kind": {"const": "frozen-preholdout-source-snapshot"},
    "created_at": {"type": "string", "format": "date-time"},
    "development_cutoff": {"type": "string", "format": "date"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_version",
          "source_sha256",
          "row_count",
          "min_session",
          "max_session",
          "license_status",
          "local_only"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_version": {"type": "string", "minLength": 1},
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "row_count": {"type": "integer", "minimum": 1},
          "min_session": {"type": "string", "format": "date"},
          "max_session": {"type": "string", "format": "date"},
          "license_status": {"type": "string", "minLength": 1},
          "local_only": {"type": "boolean"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "composite_fingerprint": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "authorized_for_development": {"type": "boolean"}
  },
  "additionalProperties": false
}
