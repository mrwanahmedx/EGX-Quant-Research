{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Point-in-time EGX Security Master Record",
  "type": "object",
  "required": [
    "canonical_security_id",
    "symbol",
    "effective_from",
    "published_at",
    "source",
    "mapping_confidence"
  ],
  "properties": {
    "canonical_security_id": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "minLength": 1},
    "effective_from": {"type": "string", "format": "date"},
    "effective_to": {"type": ["string", "null"], "format": "date"},
    "published_at": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1},
    "mapping_confidence": {"enum": ["verified", "probable", "unresolved"]},
    "sector": {"type": ["string", "null"]},
    "sector_effective_from": {"type": ["string", "null"], "format": "date"},
    "sector_published_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
