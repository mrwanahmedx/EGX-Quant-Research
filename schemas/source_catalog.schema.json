{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EGX Quant Source Catalog",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "source_id",
      "name",
      "source_url",
      "authority",
      "license_status",
      "coverage_claim",
      "approved_roles",
      "prohibited_roles",
      "point_in_time_membership_proven"
    ],
    "properties": {
      "source_id": {"type": "string", "minLength": 1},
      "name": {"type": "string", "minLength": 1},
      "source_url": {"type": "string", "pattern": "^https?://"},
      "authority": {"type": "string", "minLength": 1},
      "license_status": {"type": "string", "minLength": 1},
      "coverage_claim": {"type": "string", "minLength": 1},
      "approved_roles": {
        "type": "array",
        "items": {"type": "string", "minLength": 1},
        "uniqueItems": true
      },
      "prohibited_roles": {
        "type": "array",
        "items": {"type": "string", "minLength": 1},
        "uniqueItems": true
      },
      "point_in_time_membership_proven": {"type": "boolean"},
      "notes": {"type": "string"}
    },
    "additionalProperties": false
  }
}
